{
  "schemaVersion": "xpath-rule-pack/v1",
  "id": "yeats33.2048.xpath",
  "name": "2048 论坛",
  "version": "0.1.0",
  "description": "2048核基地论坛 RSS 订阅源，支持板块列表与详情页提取，包含磁力链/种子提取。",
  "candidates": [
    {
      "id": "2048-thread-list",
      "pageType": "forum-thread-list",
      "priority": 90,
      "detect": ["ajaxtable", "fid-"],
      "promptRule": "2048 forum thread list page: items via //table[@id='ajaxtable']//tr[contains(@class,'tr3')], title a.subject, url a.subject/@href, next page via //a[contains(text(),'下一页')]/@href",
      "selectors": {
        "items": "//table[@id='ajaxtable']//tr[contains(@class,'tr3')]",
        "title": "a.subject",
        "url": "a.subject/@href",
        "summary": ".//td[last()-1]",
        "publishedAt": "span.fl.gray/@title",
        "author": ".//td[contains(@class,'fl black')]",
        "content": null,
        "image": ".//a[contains(@href,'pic')]//img/@src",
        "nextPage": "//a[contains(text(),'下一页')]/@href",
        "customFields": [
          {
            "key": "author",
            "label": "作者",
            "xpath": ".//td[contains(@class,'fl black')]",
            "scope": "item"
          },
          {
            "key": "replies",
            "label": "回复",
            "xpath": ".//td[last()-1]",
            "scope": "item"
          }
        ],
        "contentCleanup": [
          { "pattern": "shortcut", "replacement": "" }
        ]
      }
    },
    {
      "id": "2048-thread-detail",
      "pageType": "forum-post",
      "priority": 90,
      "detect": ["read_tpc", "copytext"],
      "promptRule": "2048 forum thread detail page with magnet/content extraction",
      "selectors": {
        "items": "//*[@id='postlist']//td[contains(@class,'t_f')]",
        "title": "//*[@id='main']//*[contains(@class,'fl black')][1]",
        "url": "//*[@id='main']//a[contains(@href,'tid=')]/@href",
        "content": "//*[@id='read_tpc']",
        "image": "//*[@id='read_tpc']//img/@data-original | //*[@id='read_tpc']//img/@src",
        "author": "//*[@class='fl black']",
        "publishedAt": "span.fl.gray/@title",
        "customFields": [
          {
            "key": "magnet",
            "label": "磁力链接",
            "xpath": "//text()[contains(.,'magnet:?xt=urn:btih')]",
            "scope": "detail"
          }
        ],
        "reader": {
          "removeSelectors": [".ads", ".tips", "ignore_js_op"],
          "resolveRelativeUrls": true,
          "rewriteLinks": true,
          "showCustomFields": true
        }
      }
    }
  ]
}